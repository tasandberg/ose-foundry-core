{
  // Declaration-only build for @ose-foundry-core/types.
  //
  // Extends the base tsconfig so we inherit `types: ["foundry-vtt-types"]` and
  // the `@module/*` path alias — both needed because `src/types/*` re-exports
  // sub-model interfaces from system source and references Foundry's global
  // `Actor` / `Item`. tsc still only emits .d.ts for src/types/** (the rest is
  // type-checked in support of those emits).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "noEmitOnError": false,
    "rootDir": "src/types",
    "outDir": ".types-build"
  },
  "include": ["src/types/**/*.ts"],
  "exclude": ["src/types/**/__tests__/**"]
}
